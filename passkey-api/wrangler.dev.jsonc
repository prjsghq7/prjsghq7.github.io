{
  "name": "portfolio-passkey-api-local",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-passkeys",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "http://localhost:4173",
    "RP_ID": "localhost"
  }
}
